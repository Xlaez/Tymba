{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/web",
  "rewrites": [{ "source": "/api/:route(.*)", "destination": "/api/handler?route=:route" }],
  "functions": {
    "api/handler.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  }
}
